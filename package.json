{
  "name": "pi-browser-capture",
  "version": "0.1.0",
  "description": "Select browser regions and attach screenshots, DOM and optional login state to Pi drafts",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/pi",
    "dist/browser",
    "README.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/index.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
